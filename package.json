{
  "name": "saas-booking-platform",
  "version": "1.6.0",
  "description": "Week 1-6 Complete: Production-Ready Multi-Tenant SaaS Platform",
  "main": "index.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "test": "npm run test:server && npm run test:client",
    "build:client": "cd client && npm run build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose up -d --build",
    "migrate:up": "cd server && npm run migrate:up",
    "migrate:down": "cd server && npm run migrate:down",
    "seed": "cd server && npm run db:seed",
    "seed:large": "cd server && npm run db:seed:large"
  },
  "keywords": [
    "saas",
    "multi-tenant",
    "booking",
    "stripe",
    "real-time",
    "crdt",
    "docker",
    "mongodb",
    "redis",
    "production-ready"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
