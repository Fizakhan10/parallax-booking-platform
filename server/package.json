{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend for SaaS Booking Platform",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=src/collaboration",
    "db:seed": "node src/database/seed.js",
    "db:seed:large": "node src/database/seed-large.js",
    "db:setup": "npm run db:seed",
    "migrate:up": "node src/database/migrations/001_add_booking_indexes.js up",
    "migrate:down": "node src/database/migrations/001_add_booking_indexes.js down"
  },
  "jest": {
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [".js"],
    "transform": {}
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "pg": "^8.22.0",
    "stripe": "^22.4.0",
    "ws": "^8.18.0",
    "yjs": "^13.6.27",
    "y-websocket": "^2.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14"
  }
}
