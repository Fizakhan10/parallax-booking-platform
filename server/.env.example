# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────
# Option A: Use Docker  →  docker-compose up -d
# Option B: Native MongoDB already running on your machine
MONGODB_URI=mongodb://localhost:27017/multitenant_saas

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── Cookies ───────────────────────────────────────────────
COOKIE_SECRET=change_me_to_a_long_random_string

# ── Multi-tenant ──────────────────────────────────────────
BASE_DOMAIN=localhost:5173
SUBDOMAIN_ENABLED=true

# ── Stripe ────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Get webhook secret by running:
#   stripe listen --forward-to localhost:5000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Create products + prices in Stripe Dashboard, then paste the Price IDs here
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
